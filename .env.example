# wallet-lab · окружение для deploy/daily.sh (скопировать в /opt/wallet-lab/.env на VPS)
HYPERSYNC_TOKEN=            # бесплатный токен: https://envio.dev → API tokens
# RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/KEY   # запасной путь: --source rpc
WL_DAYS=35                  # окно потока в днях
WL_SOURCE_FALLBACK=data/launchpad-cache.json   # если потока ещё нет — считать по кэшу движка

# KalitaRegistry (ончейн-история списков; см. contracts/README.md). Без этих переменных снимки считаются, но в чейн не публикуются.
# KALITA_REGISTRY=0x...            # адрес контракта
# KALITA_RPC=https://rpc.mainnet.chain.robinhood.com
# KALITA_PUBLISHER_KEY=0x...       # горячий ключ с правом setPublisher (не владелец)
# KALITA_LIST_FAST=0
# KALITA_LIST_PICKER=1
